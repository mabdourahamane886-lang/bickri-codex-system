NEXT_PUBLIC_SUPABASE_URL=https://avgzbyvmsjjfgywtijno.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key

# Server-side coding assistant. Never use NEXT_PUBLIC_ for these secrets.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional model for real image generation and image editing (Gemini API).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional OpenAI alternative if the application is explicitly configured to use it.
OPENAI_API_KEY=replace_with_your_server_side_api_key
OPENAI_MODEL=gpt-4o-mini

# GitHub MCP remote server (Streamable HTTP). Keep both values server-side only.
GITHUB_MCP_URL=https://your-github-mcp-server.example/mcp
# Optional bearer token if your MCP server requires it; never use NEXT_PUBLIC_.
GITHUB_MCP_BEARER_TOKEN=

# Plugins de l'IA : comptes autorisés à utiliser le plugin GitHub (e-mails confirmés, séparés par des virgules).
BCX_ADMIN_EMAILS=
# Propriétaires GitHub accessibles aux plugins (défaut : mabdourahamane886-lang).
GITHUB_ALLOWED_OWNERS=mabdourahamane886-lang
GITHUB_ALLOWED_REPOSITORIES=mabdourahamane886-lang/bickri-codex-system,mabdourahamane886-lang/bickriaistudio

# BCX Deployment Manager: configure Preview-only HTTPS hooks on the providers.
# Never commit real hook URLs; add their values in the hosting provider's secret environment settings.
VERCEL_PREVIEW_DEPLOY_HOOK_URL=
CLOUDFLARE_PREVIEW_DEPLOY_HOOK_URL=
NETLIFY_PREVIEW_BUILD_HOOK_URL=
