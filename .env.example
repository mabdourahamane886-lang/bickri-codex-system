NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key

# Fournisseur IA principal : auto, google, anthropic, openai ou openrouter.
AI_PROVIDER=auto
AI_MODEL_DEFAULT=gemini-2.5-flash
AI_MODEL_FALLBACK=gemini-2.0-flash
# Modèles supplémentaires séparés par des virgules, essayés si les deux premiers sont saturés.
AI_MODEL_FALLBACKS=
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Anthropic Claude API (serveur uniquement).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# API compatible OpenAI (OpenAI ou OpenRouter). Garder les clés côté serveur.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Pour OpenRouter, choisir AI_PROVIDER=openrouter et OPENAI_BASE_URL=https://openrouter.ai/api/v1.

# Recherche Web et contenus publics des réseaux sociaux via Tavily.
TAVILY_API_KEY=

# PDF import and vector embeddings (server-side only).
BCX_PDF_EXTRACTION_MODEL=gemini-2.5-flash
BCX_EMBEDDING_MODEL=gemini-embedding-001

# API de génération / édition d'images via Gemini generateContent.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# GitHub MCP remote server (Streamable HTTP). Keep both values server-side only.
GITHUB_MCP_URL=https://your-github-mcp-server.example/mcp
GITHUB_MCP_BEARER_TOKEN=

# Google Drive OAuth 2.0 (serveur uniquement, scope drive.readonly).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Notion internal integration token (server only).
NOTION_API_KEY=

# Plugins de l'IA : comptes autorisés à utiliser le plugin GitHub.
BCX_ADMIN_EMAILS=
GITHUB_ALLOWED_OWNERS=mabdourahamane886-lang
GITHUB_ALLOWED_REPOSITORIES=mabdourahamane886-lang/bickri-codex-system,mabdourahamane886-lang/bickriaistudio

# BCX Deployment Manager: Preview-only HTTPS hooks.
VERCEL_PREVIEW_DEPLOY_HOOK_URL=
CLOUDFLARE_PREVIEW_DEPLOY_HOOK_URL=
NETLIFY_PREVIEW_BUILD_HOOK_URL=
